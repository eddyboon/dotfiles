-- See https://wiki.hypr.land/Configuring/Basics/Monitors/
-- List current monitors and supported resolutions with: hyprctl monitors all

local omarchy_gdk_scale = 2
local omarchy_monitor_scale = "auto"

hl.env("GDK_SCALE", tostring(omarchy_gdk_scale))
hl.monitor({ output = "DP-1", mode = "preferred", position = "0x0", scale = omarchy_monitor_scale })

-- Configure a specific monitor.
hl.monitor({ output = "DP-2", mode = "preferred", position = "1920x0", scale = omarchy_monitor_scale })

-- Portrait/rotated secondary monitor (transform: 1 = 90°, 3 = 270°).
-- hl.monitor({ output = "DP-2", mode = "preferred", position = "auto", scale = 1, transform = 1 })

-- Pin workspace ranges to monitors so SUPER+1..0 always lands on the same
-- screen. Monitor 1 = DP-1 (left), Monitor 2 = DP-2 (right).
-- To change the split later, edit the ranges/output names below.
for workspace = 1, 5 do
  hl.workspace_rule({ workspace = tostring(workspace), monitor = "DP-2", default = (workspace == 1), persistent = true })
end
for workspace = 6, 9 do
  hl.workspace_rule({ workspace = tostring(workspace), monitor = "DP-1", default = (workspace == 6), persistent = true })
end

-- BEGIN omarchy-display
hl.monitor({ output = "DP-1", mode = "1920x1080@60.00000Hz", position = "0x0", scale = 1, transform = 0 })
hl.monitor({ output = "DP-2", mode = "1920x1080@100.00000Hz", position = "1920x0", scale = 1, transform = 0 })
-- END omarchy-display
